generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                              Int              @id @default(autoincrement())
  email                           String           @unique
  username                        String           @unique
  password                        String
  name                            String?
  bio                             String?          @default("Quantum Explorer in the SynapseX Realm")
  profileImage                    String? // No default value as requested
  role                            String           @default("USER") // USER or ADMIN
  riskScore                       Float?           @default(0.0)
  lastLogin                       DateTime?
  isBetaTester                    Boolean          @default(false)
  betaAccessGrantedAt             DateTime?
  betaAccessRevokedAt             DateTime?
  betaApplications                BetaApplication[]
  betaFeedback                    BetaFeedback[]
  posts                           Post[]
  likes                           Like[]
  comments                        Comment[]
  stories                         Story[]
  savedPosts                      SavedPost[]
  followers                       Follow[]         @relation("Following")
  following                       Follow[]         @relation("Follower")
  sessions                        Session[]
  storyViews                      StoryView[]
  storyMessages                   StoryMessage[]
  storyLikes                      StoryLike[]
  platformUpdates                 PlatformUpdate[]
  sentFollowRequests              FollowRequest[]  @relation("SentFollowRequests")
  receivedFollowRequests          FollowRequest[]  @relation("ReceivedFollowRequests")
  isVerified                      Boolean          @default(false)
  isPrivate                       Boolean          @default(false)
  showActivityStatus              Boolean          @default(true)
  readReceipts                    Boolean          @default(true)
  ghostViewer                     Boolean          @default(false)
  protectedStories                Boolean          @default(false)
  profileVisitAlerts              Boolean          @default(true)
  notificationPostAlerts          Boolean          @default(true)
  notificationStoryAlerts         Boolean          @default(true)
  notificationSecurityAlerts      Boolean          @default(true)
  quantumDecayEnabled             Boolean          @default(false)
  quantumDecayDays                Int              @default(30)
  neuralGuardianEnabled           Boolean          @default(false)
  lastActiveAt                    DateTime?
  isOnline                        Boolean          @default(false)
  profileVisitsReceived           ProfileVisit[]   @relation("ProfileOwnerVisits")
  profileVisitsMade               ProfileVisit[]   @relation("ProfileVisitorVisits")
  creatorModeEnabled              Boolean          @default(false)
  creatorVerificationRequestedAt  DateTime?
  creatorVerificationStatus       String           @default("NONE")
  creatorVerifiedAt               DateTime?
  creatorVerificationReviewedById Int?
  creatorHighResUploads           Boolean          @default(false)
  creatorAnonymousShield          Boolean          @default(false)
  creatorDeepAnalytics            Boolean          @default(false)
  links                           String?          // JSON stored as text
  notificationClearedAt           DateTime?
  pendingEmail                    String?          @unique
  emailChangeOtp                  String?
  emailChangeOtpExpires           DateTime?
  otp                             String?
  otpExpires                      DateTime?
  createdAt                       DateTime         @default(now())
  updatedAt                       DateTime         @updatedAt
  @@map("user")
}

model PlatformUpdate {
  id              Int      @id @default(autoincrement())
  title           String
  summary         String
  version         String
  isPublished     Boolean  @default(true)
  sourceCommitSha String?
  authorId        Int
  author          User     @relation(fields: [authorId], references: [id])
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  @@map("platformupdate")
}

model Post {
  id           Int         @id @default(autoincrement())
  uploadId     String?     @unique // Instagram-style idempotency key
  caption      String?
  mediaUrl     String // Generic URL for both image and video
  thumbnailUrl String? // For video previews
  type         String      @default("IMAGE") // IMAGE or VIDEO
  postPassword String? // Password protection for specific posts
  userId       Int
  user         User        @relation(fields: [userId], references: [id])
  likes        Like[]
  comments     Comment[]
  savedBy      SavedPost[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  expiresAt    DateTime?
  @@map("post")
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  follower    User     @relation("Follower", fields: [followerId], references: [id])
  following   User     @relation("Following", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follow")
}

model FollowRequest {
  id          Int      @id @default(autoincrement())
  fromId      Int
  toId        Int
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  from        User     @relation("SentFollowRequests", fields: [fromId], references: [id])
  to          User     @relation("ReceivedFollowRequests", fields: [toId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([fromId, toId])
  @@map("followrequest")
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@map("like")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int
  postId    Int
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())
  @@map("comment")
}

model Story {
  id        Int            @id @default(autoincrement())
  mediaUrl  String
  type      String         @default("IMAGE") // IMAGE or VIDEO
  userId    Int
  user      User           @relation(fields: [userId], references: [id])
  expiresAt DateTime
  isProtected Boolean          @default(false)
  createdAt DateTime       @default(now())
  views     StoryView[]
  messages  StoryMessage[]
  likes     StoryLike[]
  @@map("story")
}

model ProfileVisit {
  id             Int      @id @default(autoincrement())
  profileOwnerId Int
  visitorId      Int
  createdAt      DateTime @default(now())
  profileOwner   User     @relation("ProfileOwnerVisits", fields: [profileOwnerId], references: [id], onDelete: Cascade)
  visitor        User     @relation("ProfileVisitorVisits", fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([profileOwnerId, createdAt])
  @@index([visitorId, createdAt])
  @@map("profilevisit")
}

model StoryView {
  id       Int      @id @default(autoincrement())
  storyId  Int
  userId   Int
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([storyId, userId])
  @@map("storyview")
}

model StoryMessage {
  id        Int      @id @default(autoincrement())
  content   String
  storyId   Int
  userId    Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@map("storymessage")
}

model StoryLike {
  id        Int      @id @default(autoincrement())
  storyId   Int
  userId    Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
  @@map("storylike")
}

model SavedPost {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@map("savedpost")
}

model Session {
  id         String   @id @default(uuid())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  userAgent  String?
  ipAddress  String?
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  @@map("session")
}

// Priya AI usage tracking — one row per call, used by the admin Command Center.
// userId = 0 for unauthenticated landing-page calls.
model AiUsageLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @default(0)
  endpoint   String   // 'priya' | 'priya-landing'
  tokens     Int      @default(0)
  calledAt   DateTime @default(now())

  @@index([calledAt])
  @@index([userId])
  @@map("aiusagelog")
}

// ============================================
// BETA PROGRAM SYSTEM
// ============================================

// Beta Program Applications - Users apply to become beta testers
model BetaApplication {
  id                    Int      @id @default(autoincrement())
  userId                Int
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Application Form Data
  fullName              String
  email                 String
  address               String?
  age                   Int?
  gender                String?   // Male, Female, Other, Prefer not to say
  reasonForJoining      String    // Why registering for beta
  motivation            String    // Why they want to test features
  
  // OTP Verification
  otpCode               String?
  otpExpires            DateTime?
  otpVerified           Boolean   @default(false)
  otpVerifiedAt         DateTime?
  
  // Status Management
  status                String    @default("PENDING") // PENDING, APPROVED, REJECTED, REVOKED
  reviewedById          Int?      // Admin who reviewed
  reviewedAt            DateTime?
  reviewNotes           String?   // Admin's notes
  
  // Timestamps
  appliedAt             DateTime  @default(now())
  approvedAt            DateTime?
  revokedAt             DateTime?
  
  @@index([userId])
  @@index([status])
  @@index([appliedAt])
  @@map("betaapplication")
}

// Beta Feedback - Beta testers submit feedback on features
model BetaFeedback {
  id                    Int      @id @default(autoincrement())
  userId                Int
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Feedback Content
  featureName           String?   // Which feature they're reviewing
  rating                Int?      // 1-5 stars
  title                 String
  description           String
  screenshots           String?   // JSON array of URLs
  
  // Admin Management
  isRead                Boolean   @default(false)
  readById              Int?      // Admin who read it
  readAt                DateTime?
  adminResponse         String?
  respondedAt           DateTime?
  
  // Status
  status                String    @default("SUBMITTED") // SUBMITTED, IN_REVIEW, RESOLVED, ARCHIVED
  priority              String    @default("MEDIUM")    // LOW, MEDIUM, HIGH, CRITICAL
  
  // Timestamps
  submittedAt           DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([submittedAt])
  @@index([isRead])
  @@map("betafeedback")
}

// Feature Flags - Control which beta features are enabled
model FeatureFlag {
  id                    Int      @id @default(autoincrement())
  name                  String   @unique  // e.g., "advanced_filters", "ai_recommendations"
  displayName           String             // User-friendly name
  description           String?            // What this feature does
  
  // Access Control
  enabledForBeta        Boolean  @default(false)  // Available to beta testers
  enabledForAll         Boolean  @default(false)  // Available to everyone (graduated feature)
  
  // Metadata
  createdById           Int?     // Admin who created it
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([enabledForBeta])
  @@index([enabledForAll])
  @@map("featureflag")
}

// Admin Panel - Store admin-specific settings and configurations
model AdminSetting {
  id                    Int      @id @default(autoincrement())
  key                   String   @unique   // e.g., "beta_auto_approve", "max_beta_testers"
  value                 String              // JSON-encoded value
  description           String?
  updatedById           Int?                // Admin who last updated
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
  @@map("adminsetting")
}

// Admin Activity Log - Track all admin actions for audit
model AdminActivityLog {
  id                    Int      @id @default(autoincrement())
  adminId               Int      // Which admin performed action
  action                String   // e.g., "APPROVE_BETA", "REVOKE_BETA", "DELETE_USER"
  targetType            String?  // "USER", "BETA_APPLICATION", "FEEDBACK"
  targetId              Int?     // ID of affected resource
  details               String?  // JSON with additional context
  ipAddress             String?
  userAgent             String?
  performedAt           DateTime @default(now())
  
  @@index([adminId])
  @@index([performedAt])
  @@index([action])
  @@map("adminactivitylog")
}

// Beta Notifications - Targeted notifications for beta program events
model BetaNotification {
  id            Int      @id @default(autoincrement())
  userId        Int      // The user who should SEE this notification
  type          String   // BETA_APPLICATION_RECEIVED, BETA_APPROVED, BETA_REJECTED, BETA_REVOKED
  title         String
  detail        String
  actorName     String?
  actorImage    String?
  actorUsername  String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("betanotification")
}
