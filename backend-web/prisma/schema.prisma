generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                              Int              @id @default(autoincrement())
  email                           String           @unique
  username                        String           @unique
  password                        String
  name                            String?
  bio                             String?          @default("Quantum Explorer in the SynapseX Realm")
  profileImage                    String? // No default value as requested
  role                            String           @default("USER") // USER or ADMIN
  riskScore                       Float?           @default(0.0)
  lastLogin                       DateTime?
  posts                           Post[]
  likes                           Like[]
  comments                        Comment[]
  stories                         Story[]
  savedPosts                      SavedPost[]
  followers                       Follow[]         @relation("Following")
  following                       Follow[]         @relation("Follower")
  sessions                        Session[]
  storyViews                      StoryView[]
  storyMessages                   StoryMessage[]
  storyLikes                      StoryLike[]
  platformUpdates                 PlatformUpdate[]
  sentFollowRequests              FollowRequest[]  @relation("SentFollowRequests")
  receivedFollowRequests          FollowRequest[]  @relation("ReceivedFollowRequests")
  isVerified                      Boolean          @default(false)
  isPrivate                       Boolean          @default(false)
  showActivityStatus              Boolean          @default(true)
  readReceipts                    Boolean          @default(true)
  ghostViewer                     Boolean          @default(false)
  protectedStories                Boolean          @default(false)
  profileVisitAlerts              Boolean          @default(true)
  notificationPostAlerts          Boolean          @default(true)
  notificationStoryAlerts         Boolean          @default(true)
  notificationSecurityAlerts      Boolean          @default(true)
  quantumDecayEnabled             Boolean          @default(false)
  quantumDecayDays                Int              @default(30)
  neuralGuardianEnabled           Boolean          @default(false)
  lastActiveAt                    DateTime?
  isOnline                        Boolean          @default(false)
  profileVisitsReceived           ProfileVisit[]   @relation("ProfileOwnerVisits")
  profileVisitsMade               ProfileVisit[]   @relation("ProfileVisitorVisits")
  creatorModeEnabled              Boolean          @default(false)
  creatorVerificationRequestedAt  DateTime?
  creatorVerificationStatus       String           @default("NONE")
  creatorVerifiedAt               DateTime?
  creatorVerificationReviewedById Int?
  creatorHighResUploads           Boolean          @default(false)
  creatorAnonymousShield          Boolean          @default(false)
  creatorDeepAnalytics            Boolean          @default(false)
  links                           String?          // JSON stored as text
  notificationClearedAt           DateTime?
  pendingEmail                    String?          @unique
  emailChangeOtp                  String?
  emailChangeOtpExpires           DateTime?
  otp                             String?
  otpExpires                      DateTime?
  createdAt                       DateTime         @default(now())
  updatedAt                       DateTime         @updatedAt
}

model PlatformUpdate {
  id              Int      @id @default(autoincrement())
  title           String
  summary         String
  version         String
  isPublished     Boolean  @default(true)
  sourceCommitSha String?
  authorId        Int
  author          User     @relation(fields: [authorId], references: [id])
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
}

model Post {
  id           Int         @id @default(autoincrement())
  uploadId     String?     @unique // Instagram-style idempotency key
  caption      String?
  mediaUrl     String // Generic URL for both image and video
  thumbnailUrl String? // For video previews
  type         String      @default("IMAGE") // IMAGE or VIDEO
  postPassword String? // Password protection for specific posts
  userId       Int
  user         User        @relation(fields: [userId], references: [id])
  likes        Like[]
  comments     Comment[]
  savedBy      SavedPost[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  expiresAt    DateTime?
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  follower    User     @relation("Follower", fields: [followerId], references: [id])
  following   User     @relation("Following", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model FollowRequest {
  id          Int      @id @default(autoincrement())
  fromId      Int
  toId        Int
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  from        User     @relation("SentFollowRequests", fields: [fromId], references: [id])
  to          User     @relation("ReceivedFollowRequests", fields: [toId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([fromId, toId])
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int
  postId    Int
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())
}

model Story {
  id        Int            @id @default(autoincrement())
  mediaUrl  String
  type      String         @default("IMAGE") // IMAGE or VIDEO
  userId    Int
  user      User           @relation(fields: [userId], references: [id])
  expiresAt DateTime
  isProtected Boolean          @default(false)
  createdAt DateTime       @default(now())
  views     StoryView[]
  messages  StoryMessage[]
  likes     StoryLike[]
}

model ProfileVisit {
  id             Int      @id @default(autoincrement())
  profileOwnerId Int
  visitorId      Int
  createdAt      DateTime @default(now())
  profileOwner   User     @relation("ProfileOwnerVisits", fields: [profileOwnerId], references: [id], onDelete: Cascade)
  visitor        User     @relation("ProfileVisitorVisits", fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([profileOwnerId, createdAt])
  @@index([visitorId, createdAt])
}

model StoryView {
  id       Int      @id @default(autoincrement())
  storyId  Int
  userId   Int
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([storyId, userId])
}

model StoryMessage {
  id        Int      @id @default(autoincrement())
  content   String
  storyId   Int
  userId    Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model StoryLike {
  id        Int      @id @default(autoincrement())
  storyId   Int
  userId    Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
  @@map("storylike")
}

model SavedPost {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Session {
  id         String   @id @default(uuid())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  userAgent  String?
  ipAddress  String?
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())
  expiresAt  DateTime
}

// Priya AI usage tracking — one row per call, used by the admin Command Center.
// userId = 0 for unauthenticated landing-page calls.
model AiUsageLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @default(0)
  endpoint   String   // 'priya' | 'priya-landing'
  tokens     Int      @default(0)
  calledAt   DateTime @default(now())

  @@index([calledAt])
  @@index([userId])
}
